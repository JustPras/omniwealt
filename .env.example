# ============================================================
# OMNIWEALTH ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env or .env.local to configure your local keys.
# NEVER commit your actual .env file or API keys to version control.
# ============================================================

# 1. Google Gemini AI (Optional)
# Digunakan untuk OCR ekstraksi statement mutasi bank & broker PDF otomatis
EXPO_PUBLIC_GEMINI_API_KEY=

# 2. Supabase Cloud Sync (Optional)
# Digunakan jika Anda mengaktifkan backup & sinkronisasi multi-perangkat
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
