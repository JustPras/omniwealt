# ============================================================
# OMNIWEALTH ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env or .env.local to configure your local keys.
# NEVER commit your actual .env file or API keys to version control.
# ============================================================

# 1. Google Gemini AI (SECURE — Server-Side via Supabase Edge Function)
# The Gemini API key NEVER ships in the client bundle. It is stored server-side
# as a Supabase function secret and called through the `gemini-proxy` edge function.
#
# Deploy + set secret (on host machine, NOT in this file):
#   supabase functions deploy gemini-proxy --project-ref <ref>
#   supabase secrets set GEMINI_API_KEY=<your-key>
#
# Only the public Supabase URL & anon key are needed on the client:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 2. DEV-ONLY fallback key (OPTIONAL — do NOT use for production)
# If you want a local/dev direct-SDK fallback when the Edge Function is not
# deployed or unreachable, you may optionally set this. It WILL be bundled into
# the client, so never set it for a shipped build.
EXPO_PUBLIC_GEMINI_API_KEY=
