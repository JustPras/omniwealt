{
  "expo": {
    "name": "OmniWealth",
    "slug": "omniwealth",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "omniwealth",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1D1D1F",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D1D1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omniwealth.nativeapp"
    },
    "android": {
      "backgroundColor": "#1D1D1F",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D1D1F"
      },
      "package": "com.omniwealth.nativeapp",
      "allowBackup": false,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
