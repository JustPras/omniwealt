{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist-tests"
  },
  "include": [
    "src/utils/decimal.ts",
    "src/utils/crypto.ts",
    "src/types/**/*.ts",
    "src/services/rdn-pipeline/**/*.ts",
    "tests/**/*.ts"
  ]
}
